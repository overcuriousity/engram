{
  "manifest_version": 3,
  "name": "engram",
  "version": "0.1.0",
  "description": "Capture what you are reading into engram, and search it from here.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "sidePanel",
    "identity"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "shared/background.js" },
  "side_panel": { "default_path": "shared/panel.html" },
  "icons": {
    "16": "shared/icon-16.png",
    "32": "shared/icon-32.png",
    "48": "shared/icon-48.png",
    "128": "shared/icon-128.png"
  },
  "action": {
    "default_title": "engram",
    "default_icon": {
      "16": "shared/icon-16.png",
      "32": "shared/icon-32.png",
      "48": "shared/icon-48.png",
      "128": "shared/icon-128.png"
    }
  },
  "omnibox": { "keyword": "eg" }
}
