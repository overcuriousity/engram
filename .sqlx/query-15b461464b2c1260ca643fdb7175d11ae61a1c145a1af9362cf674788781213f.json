  "query": "UPDATE jobs\n                SET state = 'running', claimed_at = ?, attempts = attempts + 1\n              WHERE id = (\n                SELECT id FROM jobs\n                 WHERE subject = ? AND state = 'pending' AND run_after <= ?\n                 ORDER BY class, attempts, seq, id LIMIT 1\n              )\n              RETURNING id, stage, target_kind, target_id, attempts",
