  "query": "SELECT o.id AS \"id!\", o.created_at AS \"created_at!\", o.generation_id AS \"generation_id!\", o.query AS \"query!\", o.query_vec AS \"query_vec!\", o.artifact_id AS \"artifact_id?\", o.rank AS \"rank?\", o.source AS \"source!\", o.strength AS \"strength!\", o.event_id AS \"event_id?\", o.embed_model AS \"embed_model!\"\n               FROM observations o\n               JOIN generations g ON g.id = o.generation_id\n              WHERE o.artifact_id = ? AND o.created_at <= ? AND o.strength > 0\n                AND o.excluded_at IS NULL\n                AND g.embed_recipe = ? AND g.chat_model = ?\n              ORDER BY o.created_at DESC, o.id DESC\n              LIMIT ?",
