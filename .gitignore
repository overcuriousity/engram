/target
/config.toml
/engram.env
*.db
*.db-wal
*.db-shm

# Evaluation corpus. Whatever documents the operator actually wants to search,
# and never publishable by default — the harness reads it from ENGRAM_EVAL_DIR,
# and this only guards the in-repo default path.
/eval-data/

# Generated by extension/pack.sh — one source of truth lives in extension/shared/
extension/*/shared/

# Built from extension/ by build.rs at compile time. `firefox.xpi` is the
# unsigned package unless a signed one is committed at extension/firefox-signed.xpi,
# in which case build.rs copies that across and drops the `.signed` marker
# beside it for the install page to read.
assets/extension/chrome.zip
assets/extension/firefox.xpi
assets/extension/firefox.signed
